---
import SiteLayout from '../layouts/SiteLayout.astro';
import releaseData from '../data/releases.json';
import {
  releaseManifestSchema,
  formatBytes,
  shortChecksum
} from '../data/release-schema.mjs';
import '../styles/download.css';

const manifest = releaseManifestSchema.parse(releaseData);
const releases = manifest.releases;
const hasReleases = releases.length > 0;
---

<SiteLayout
  title="Downloads — Nocturne Engine"
  description="Published Nocturne Engine builds with platform, architecture, channel, size and SHA-256 metadata."
>
  <section class="download shell" aria-labelledby="download-title">
    <header class="download-heading">
      <div>
        <span class="eyebrow">NOCTURNE / RELEASES</span>
        <h1 id="download-title">Downloads</h1>
        <p>
          Every download on this page comes from validated release metadata.
          An architecture is not shown as downloadable until CI has produced,
          packaged and published the matching artifact.
        </p>
      </div>

      <div class="manifest-status" aria-label="Release manifest status">
        <span class:list={['manifest-dot', hasReleases ? 'live' : 'empty']} aria-hidden="true"></span>
        <div>
          <strong>{hasReleases ? 'Release manifest active' : 'No public release yet'}</strong>
          <small>
            schema v{manifest.schemaVersion}
            {hasReleases ? ` · latest ${manifest.latest}` : ' · 0 published artifacts'}
          </small>
        </div>
      </div>
    </header>

    {hasReleases ? (
      <div class="release-list">
        {releases.map((release) => (
          <article class="release-card">
            <header class="release-header">
              <div class="release-title">
                <div>
                  <span class="version">v{release.version}</span>
                  {manifest.latest === release.version && (
                    <span class="latest">Latest</span>
                  )}
                  <span class:list={['channel', `channel-${release.channel}`]}>
                    {release.channel}
                  </span>
                </div>
                <div class="release-meta">
                  <time datetime={release.publishedAt}>{release.publishedAt}</time>
                  <span aria-hidden="true">·</span>
                  <code title={release.sourceCommit}>
                    {release.sourceCommit.slice(0, 8)}
                  </code>
                </div>
              </div>

              <a class="notes-link" href={release.notesUrl}>Release notes →</a>
            </header>

            <div class="build-list">
              {release.builds.map((build) => {
                const downloadable = build.status !== 'withdrawn';
                return (
                  <section class="build-row">
                    <div class="build-identity">
                      <span
                        class:list={[
                          'build-status',
                          `status-${build.status}`
                        ]}
                      >
                        {build.status}
                      </span>
                      <div>
                        <strong>
                          {build.platform} · {build.architecture}
                        </strong>
                        <small>
                          {build.configuration} · {formatBytes(build.bytes)}
                        </small>
                      </div>
                    </div>

                    <dl class="build-details">
                      <div>
                        <dt>File</dt>
                        <dd title={build.file}>{build.file}</dd>
                      </div>
                      <div>
                        <dt>SHA-256</dt>
                        <dd>
                          <code title={build.sha256}>
                            {shortChecksum(build.sha256)}
                          </code>
                        </dd>
                      </div>
                    </dl>

                    {downloadable ? (
                      <a class="download-button" href={build.url}>
                        Download
                        <span aria-hidden="true">↓</span>
                      </a>
                    ) : (
                      <span class="withdrawn-action">Withdrawn</span>
                    )}
                  </section>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-grid">
        <section class="empty-state">
          <div class="empty-status">
            <span class="status-dot" aria-hidden="true"></span>
            PUBLIC RELEASE NOT PUBLISHED
          </div>
          <h2>The release pipeline is ready. The manifest is intentionally empty.</h2>
          <p>
            CI may validate candidate architectures without making them public.
            The first download appears here only after a tagged release publishes
            the artifact, checksum and release metadata.
          </p>

          <div class="empty-actions">
            <a class="button primary" href="/docs/">Read documentation</a>
            <a class="button" href="https://github.com/AdelinAndrica/nocturne-engine/releases">
              GitHub releases
            </a>
          </div>
        </section>

        <aside class="validation-card">
          <span class="card-label">CURRENT PUBLIC STATE</span>
          <dl>
            <div>
              <dt>Published releases</dt>
              <dd>0</dd>
            </div>
            <div>
              <dt>Downloadable architectures</dt>
              <dd>None</dd>
            </div>
            <div>
              <dt>Manifest schema</dt>
              <dd>v{manifest.schemaVersion}</dd>
            </div>
            <div>
              <dt>Release configuration</dt>
              <dd>Ship</dd>
            </div>
          </dl>
        </aside>
      </div>
    )}

    <section class="release-contract" aria-labelledby="release-contract-title">
      <header>
        <span class="eyebrow">ARTIFACT CONTRACT</span>
        <h2 id="release-contract-title">What a public build must prove.</h2>
      </header>

      <div class="contract-grid">
        <article>
          <span>01</span>
          <h3>Ship build</h3>
          <p>
            Engine, host and editor must compile in the Ship configuration for
            the target architecture.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Package</h3>
          <p>
            The bundle is assembled deterministically with the runtime Data
            directory and release identity metadata.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Checksum</h3>
          <p>
            Every archive receives a SHA-256 checksum and exact byte size before
            it can enter the public manifest.
          </p>
        </article>
        <article>
          <span>04</span>
          <h3>Publish</h3>
          <p>
            A tagged GitHub release hosts the archive. Only then may its validated
            record be promoted into this page.
          </p>
        </article>
      </div>
    </section>

    <aside class="policy">
      <div>
        <span class="eyebrow">SUPPORT POLICY</span>
        <h2>Configuration is not the same as support.</h2>
      </div>
      <p>
        Visual Studio project files may contain architecture configurations that
        are not yet release-validated. x86, ARM64 or any future target is only
        presented here after its Ship package gate succeeds and a public artifact
        exists.
      </p>
      <a href="/docs/development/production-engineering-standard/">
        Production engineering standard →
      </a>
    </aside>
  </section>
</SiteLayout>
