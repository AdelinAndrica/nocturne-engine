---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/landing.css';

const capabilities = [
  {
    number: '01',
    title: 'Runtime',
    id: 'noc.runtime',
    icon: '/icons/terminal-2.svg',
    href: '/docs/systems/runtime/',
    description:
      'One engine-owned lifecycle coordinates configuration, jobs, input, resources, world updates and frame execution.'
  },
  {
    number: '02',
    title: 'Resources',
    id: 'noc.resources',
    icon: '/icons/file-text.svg',
    href: '/docs/systems/resources/',
    description:
      'Virtual paths, loose/archive mounts, asynchronous requests and typed loaders share one runtime resource boundary.'
  },
  {
    number: '03',
    title: 'Rendering',
    id: 'noc.render',
    icon: '/icons/device-desktop.svg',
    href: '/docs/systems/rendering/',
    description:
      'A DirectX 12 backend consumes explicit frame data extracted from the runtime world instead of owning gameplay state.'
  },
  {
    number: '04',
    title: 'World & ECS',
    id: 'noc.world',
    icon: '/icons/world.svg',
    href: '/docs/systems/world-ecs/',
    description:
      'Generational entity identity and component-owned Transform, Renderable, Camera and Name data form the current world model.'
  },
  {
    number: '05',
    title: 'Editor',
    id: 'noc.editor',
    icon: '/icons/layout-grid.svg',
    href: '/docs/systems/editor/',
    description:
      'EditorShellV3 is a native Windows authoring surface layered on the same runtime, world and renderer used by the engine.'
  }
];

const architecture = [
  { label: 'Application policy', detail: 'config / content roots' },
  { label: 'Engine Runtime', detail: 'lifecycle / frame' },
  { label: 'World & ECS', detail: 'authoritative state' },
  { label: 'Render Queue', detail: 'frame extraction' },
  { label: 'DirectX 12', detail: 'GPU / present' }
];
---

<SiteLayout
  title="Nocturne Engine — Windows C++ Game Engine"
  description="Nocturne Engine is a custom Windows C++20+ game engine and native editor for a first-person survival horror game, with DirectX 12 rendering and canonical technical documentation."
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        NOCTURNE / ENGINE
      </div>

      <h1 id="hero-title">
        Built for
        <span>the dark.</span>
      </h1>

      <p class="lede">
        A custom Windows game engine and native editor built in C++20+ for a
        first-person survival horror game. One runtime, one world model and one
        editor, with DirectX 12 rendering and documentation that tracks the code.
      </p>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/docs/">
          Explore documentation
          <span aria-hidden="true">→</span>
        </a>
        <a class="button" href="/download">Downloads</a>
      </div>

      <dl class="hero-facts" aria-label="Nocturne Engine technology">
        <div>
          <dt>Platform</dt>
          <dd>Windows</dd>
        </div>
        <div>
          <dt>Language</dt>
          <dd>C++20+</dd>
        </div>
        <div>
          <dt>Renderer</dt>
          <dd>DirectX 12</dd>
        </div>
      </dl>
    </div>

    <figure class="editor-figure">
      <figcaption>
        <span>EditorShellV3</span>
        <span>Interface schematic · derived from the current editor layout</span>
      </figcaption>

      <div class="editor-window" aria-label="EditorShellV3 interface schematic">
        <div class="editor-menu">
          <div class="editor-brand">
            <img src="/nocturne-logo.png" alt="" />
            <span>NOCTURNE</span>
          </div>
          <div class="menu-items" aria-hidden="true">
            <span>File</span>
            <span>Edit</span>
            <span>View</span>
            <span>Tools</span>
            <span>Build</span>
          </div>
          <span class="window-title">Nocturne Editor</span>
        </div>

        <div class="editor-toolbar" aria-hidden="true">
          <div class="tool-cluster">
            <span class="tool active">Select</span>
            <span class="tool">Move</span>
            <span class="tool">Rotate</span>
            <span class="tool">Scale</span>
          </div>
          <div class="tool-cluster">
            <span class="tool success">Play</span>
          </div>
        </div>

        <div class="editor-workspace">
          <section class="editor-panel hierarchy-panel" aria-label="Scene Hierarchy schematic">
            <div class="panel-title">
              <span class="panel-icon hierarchy-icon" aria-hidden="true"></span>
              <span>Scene Hierarchy</span>
            </div>
            <div class="tree">
              <div class="tree-row root selected">
                <span class="chevron">⌄</span>
                <span class="tree-dot world"></span>
                <b>Runtime World</b>
              </div>
              <div class="tree-row child">
                <span></span>
                <span class="tree-dot camera"></span>
                <span>Editor Camera</span>
              </div>
              <div class="tree-row child">
                <span></span>
                <span class="tree-dot mesh"></span>
                <span>Cube_A</span>
              </div>
              <div class="tree-row child">
                <span></span>
                <span class="tree-dot mesh"></span>
                <span>Cube_B</span>
              </div>
              <div class="tree-row child">
                <span></span>
                <span class="tree-dot mesh"></span>
                <span>Cube_C</span>
              </div>
              <div class="tree-row child">
                <span></span>
                <span class="tree-dot mesh"></span>
                <span>Ground</span>
              </div>
            </div>
          </section>

          <section class="viewport-panel" aria-label="Rendering viewport schematic">
            <div class="panel-title viewport-title">
              <span class="panel-icon viewport-icon" aria-hidden="true"></span>
              <span>Viewport</span>
              <span class="viewport-mode">Perspective</span>
            </div>
            <div class="viewport-scene">
              <div class="sky-glow"></div>
              <div class="viewport-grid"></div>
              <div class="cube cube-a"><i></i><b></b></div>
              <div class="cube cube-b"><i></i><b></b></div>
              <div class="cube cube-c selected-cube"><i></i><b></b></div>
              <div class="gizmo" aria-hidden="true">
                <span class="axis axis-x"></span>
                <span class="axis axis-y"></span>
                <span class="axis axis-z"></span>
              </div>
              <div class="viewport-overlay">
                <span>DX12</span>
                <span>Camera · Perspective</span>
              </div>
            </div>
          </section>

          <section class="editor-panel inspector-panel" aria-label="Inspector schematic">
            <div class="panel-title">
              <span class="panel-icon inspector-icon" aria-hidden="true"></span>
              <span>Inspector</span>
            </div>
            <div class="inspector-content">
              <div class="object-name">Cube_C</div>
              <div class="component">
                <div class="component-title">Transform</div>
                <div class="property"><span>Position</span><code>1.8 · 0.8 · 1.2</code></div>
                <div class="property"><span>Rotation</span><code>0 · 0 · 0</code></div>
                <div class="property"><span>Scale</span><code>1 · 1 · 1</code></div>
              </div>
              <div class="component">
                <div class="component-title">Renderable</div>
                <div class="property"><span>Enabled</span><code>true</code></div>
                <div class="property"><span>Mesh</span><code>Cube</code></div>
              </div>
            </div>
          </section>

          <section class="editor-panel content-panel-schematic" aria-label="Content Browser schematic">
            <div class="panel-title">
              <span class="panel-icon content-icon" aria-hidden="true"></span>
              <span>Content Browser</span>
              <span class="panel-meta">Data/</span>
            </div>
            <div class="asset-row">
              <span class="asset active"><i></i>Meshes</span>
              <span class="asset"><i></i>Textures</span>
              <span class="asset"><i></i>Shaders</span>
              <span class="asset"><i></i>Materials</span>
            </div>
          </section>

          <section class="editor-panel console-panel" aria-label="Console schematic">
            <div class="panel-title">
              <span class="panel-icon console-icon" aria-hidden="true"></span>
              <span>Console</span>
            </div>
            <div class="console-lines">
              <span><b>[Render]</b> DX12 viewport ready</span>
              <span><b>[World]</b> Runtime world active</span>
              <span><b>[Editor]</b> Selection synchronized</span>
            </div>
          </section>
        </div>

        <div class="editor-status">
          <span><i></i> Ready</span>
          <span>World · 5 entities</span>
          <span>EditorShellV3</span>
        </div>
      </div>
    </figure>
  </section>

  <section class="status-strip" aria-label="Current development foundation">
    <div class="shell status-strip-inner">
      <div>
        <span class="status-label">CURRENT FOUNDATION</span>
        <strong>Phases 1–15 implemented</strong>
      </div>
      <div class="status-divider" aria-hidden="true"></div>
      <div>
        <span class="status-label">ACTIVE ENGINE WORK</span>
        <strong>Scene editing + runtime reflection</strong>
      </div>
      <a href="/docs/architecture/overview/">View roadmap →</a>
    </div>
  </section>

  <section class="section shell capabilities" aria-labelledby="capabilities-title">
    <header class="section-heading">
      <span class="eyebrow">IMPLEMENTED SYSTEMS</span>
      <h2 id="capabilities-title">A foundation with explicit ownership.</h2>
      <p>
        These are current engine contracts backed by implementation and canonical
        documentation — not planned roadmap features presented as finished work.
      </p>
    </header>

    <div class="capability-grid">
      {capabilities.map((item) => (
        <a class="capability-card" href={item.href}>
          <div class="capability-top">
            <span
              class="capability-icon"
              style={`--icon: url("${item.icon}")`}
              aria-hidden="true"
            ></span>
            <span class="capability-number">{item.number}</span>
          </div>
          <div class="capability-copy">
            <div class="capability-title-row">
              <h3>{item.title}</h3>
              <span class="implemented">Implemented</span>
            </div>
            <p>{item.description}</p>
            <code>{item.id}</code>
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section architecture-section" aria-labelledby="architecture-title">
    <div class="shell">
      <header class="section-heading architecture-heading">
        <span class="eyebrow">ARCHITECTURE</span>
        <h2 id="architecture-title">Policy flows down. Data flows across explicit seams.</h2>
        <p>
          The application supplies policy. Runtime coordinates execution. World owns
          authoritative entity/component state. Rendering consumes extracted frame data.
        </p>
      </header>

      <div class="architecture-card">
        <div class="architecture-flow" aria-label="Nocturne Engine high-level data flow">
          {architecture.map((node, index) => (
            <>
              <div class="architecture-node">
                <span class="node-index">{String(index + 1).padStart(2, '0')}</span>
                <strong>{node.label}</strong>
                <small>{node.detail}</small>
              </div>
              {index < architecture.length - 1 && (
                <span class="flow-arrow" aria-hidden="true">→</span>
              )}
            </>
          ))}
        </div>

        <div class="service-rail">
          <span>Engine services</span>
          <div>
            <a href="/docs/systems/resources/">Resources / VFS</a>
            <span>Jobs</span>
            <span>Input</span>
            <a href="/docs/systems/editor/">Editor client</a>
          </div>
        </div>
      </div>

      <div class="architecture-link">
        <a href="/docs/architecture/overview/">Read the architectural contract →</a>
      </div>
    </div>
  </section>

  <section class="section shell docs-showcase" aria-labelledby="docs-title">
    <div class="docs-copy">
      <span class="eyebrow">CANONICAL DOCUMENTATION</span>
      <h2 id="docs-title">Readable by humans. Structured for tools.</h2>
      <p>
        Current architecture and system pages are explicitly separated from historical
        phase records. Stable <code>noc.*</code> IDs, source references and book grounding
        make the current authority easy to locate.
      </p>

      <ul class="docs-points">
        <li><span>01</span> Canonical vs. historical source precedence</li>
        <li><span>02</span> Static Pagefind search across generated documentation</li>
        <li><span>03</span> Stable semantic IDs independent of filenames</li>
      </ul>

      <a class="text-link" href="/docs/">Open Nocturne Docs →</a>
    </div>

    <div class="docs-preview" aria-label="Nocturne documentation interface preview">
      <div class="docs-preview-bar">
        <div class="preview-brand">
          <img src="/nocturne-logo.png" alt="" />
          <span>NOCTURNE</span>
          <i></i>
          <span>DOCS</span>
        </div>
        <div class="preview-search">
          <span>Search Nocturne docs</span>
          <kbd>Ctrl K</kbd>
        </div>
      </div>

      <div class="docs-preview-body">
        <aside aria-label="Documentation navigation preview">
          <span class="nav-heading">SYSTEMS</span>
          <span>Runtime</span>
          <span>Resources</span>
          <span class="active">Rendering</span>
          <span>World & ECS</span>
          <span>Editor</span>
          <span class="nav-heading history">HISTORY</span>
          <span>Development History</span>
        </aside>

        <article>
          <div class="doc-badges">
            <span>CANONICAL</span>
            <span>RENDERING</span>
            <span>IMPLEMENTED</span>
          </div>
          <h3>Rendering</h3>
          <code>noc.render</code>
          <p>
            The Rendering layer owns GPU interaction and presentation. It consumes
            frame data produced by runtime/world systems.
          </p>
          <div class="doc-code">
            <span>World / ECS</span>
            <b>→</b>
            <span>RenderQueue</span>
            <b>→</b>
            <span>DX12</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section shell release-section" aria-labelledby="release-title">
    <div class="release-card">
      <div class="release-copy">
        <span class="eyebrow">DOWNLOADS</span>
        <h2 id="release-title">Artifacts only when they are real.</h2>
        <p>
          The current development target is Windows x86_64. The public Downloads page
          intentionally stays artifact-driven and will not invent ARM64, x86 or release
          packages that the pipeline has not produced.
        </p>
        <a class="button" href="/download">View downloads</a>
      </div>

      <div class="release-status">
        <div class="release-status-head">
          <span>PUBLIC RELEASE</span>
          <strong>Not published</strong>
        </div>
        <dl>
          <div>
            <dt>Development target</dt>
            <dd>Windows · x86_64</dd>
          </div>
          <div>
            <dt>Engine language</dt>
            <dd>C++20+</dd>
          </div>
          <div>
            <dt>Graphics backend</dt>
            <dd>DirectX 12</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</SiteLayout>
