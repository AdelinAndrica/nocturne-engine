    height: 26px;
    object-fit: contain;
  }

  .noc-site-title__brand {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
  }

  .noc-site-title__divider {
    width: 1px;
    height: 16px;
    background: var(--noc-border);
  }

  .noc-site-title__section {
    color: var(--noc-text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media (max-width: 500px) {
    .noc-site-title__divider,
    .noc-site-title__section {
