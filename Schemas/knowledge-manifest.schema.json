{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocturne.engine/schemas/knowledge-manifest.schema.json",
  "title": "Nocturne Engine Knowledge Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sourcePrecedence",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "platform",
        "language",
        "target",
        "canonicalDocsRoot"
      ],
      "properties": {
        "id": {
          "const": "nocturne-engine"
        },
        "name": {
          "const": "Nocturne Engine"
        },
        "platform": {
          "const": "Windows"
        },
        "language": {
          "const": "C++20+"
        },
        "target": {
          "const": "first-person survival horror"
        },
        "canonicalDocsRoot": {
          "const": "Docs/"
        }
      }
    },
    "sourcePrecedence": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "docType",
        "canonical",
        "status",
        "sourcePath",
        "webPath",
        "rawPath",
        "aiPath",
        "description",
        "sourceFiles",
        "sourceDocs",
        "bookGrounding",
        "aliases",
        "deprecatedAliases",
        "apiSymbols"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^noc\\.[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "docType": {
          "enum": [
            "architecture",
            "system",
            "standard",
            "web-spec",
            "reference"
          ]
        },
        "canonical": {
          "const": true
        },
        "status": {
          "enum": [
            "implemented",
            "active",
            "planned",
            "foundation"
          ]
        },
        "subsystem": {
          "type": "string",
          "minLength": 1
        },
        "phaseIntroduced": {
          "type": "integer",
          "minimum": 1
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^Docs/"
        },
        "webPath": {
          "type": "string",
          "pattern": "^/docs/"
        },
        "rawPath": {
          "type": "string",
          "pattern": "^/raw/noc\\."
        },
        "aiPath": {
          "type": "string",
          "pattern": "^/ai/noc\\."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceDocs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bookGrounding": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deprecatedAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "apiSymbols": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "href"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "pattern": "^/api-symbol/"
              }
            }
          }
        }
      }
    }
  }
}
