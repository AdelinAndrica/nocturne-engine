{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nocturne.engine/schemas/release.schema.json",
  "title": "Nocturne Engine Release Manifest",
  "description": "Static website release metadata. Presence in this manifest means an artifact was actually published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "latest", "releases"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "latest": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "channel",
        "publishedAt",
        "notesUrl",
        "sourceCommit",
        "builds"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "channel": {
          "enum": ["development", "preview", "stable"]
        },
        "publishedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notesUrl": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "builds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/build"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "configuration",
        "status",
        "file",
        "bytes",
        "sha256",
        "url"
      ],
      "properties": {
        "platform": {
          "enum": ["windows"]
        },
        "architecture": {
          "enum": ["x86_64", "x86", "arm64"]
        },
        "configuration": {
          "enum": ["ship"]
        },
        "status": {
          "enum": ["supported", "experimental", "withdrawn"]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    }
  }
}
